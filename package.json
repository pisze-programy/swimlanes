{
  "name": "swimlanes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sequence diagrams from text.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/gen-icons.mjs && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "e2e:web": "npm run build && wrangler dev --port 8788 --ip 127.0.0.1",
    "icons": "node scripts/gen-icons.mjs",
    "deploy": "npm run build && wrangler deploy",
    "cf:dev": "npm run build && wrangler dev",
    "kv:create": "wrangler kv namespace create DIAGRAMS"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261014.1",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wrangler": "^4.151.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261012.1": true
  }
}
